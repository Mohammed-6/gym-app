{
  "name": "gym-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "pnpm --filter @gym-app/web dev",
    "dev:api": "pnpm --filter @gym-app/api dev",
    "build": "pnpm --filter @gym-app/shared build && pnpm --filter @gym-app/api build && pnpm --filter @gym-app/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"]
  }
}
