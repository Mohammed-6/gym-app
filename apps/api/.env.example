MONGODB_URI=mongodb://127.0.0.1:27017/gym-app
PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Seed admin user (used by `pnpm seed`)
SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Admin
SEED_BRANCH_NAME=Main Branch

# Member/branch photo storage (Google Cloud Storage). If GCP_STORAGE_BUCKET is left unset,
# photos are saved to ./uploads on local disk instead — fine for development, not for production.
GCP_STORAGE_BUCKET=
GCP_PROJECT_ID=
# Path to a service account JSON key file (standard Google SDK convention):
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative to the file path above, for hosts where writing a key file is awkward
# (paste the service account JSON as a single-line string):
GCP_SERVICE_ACCOUNT_KEY=
